{
  "$id": "https://schemas.ai-sdk.local/0.1.0/usage.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Token counts a provider reported for itself.\n\nAbsent usage means the provider reported none. It never means zero, and\nmust not be fabricated as zero. Estimation lives in run accounting.",
  "properties": {
    "inputTokens": {
      "description": "Prompt tokens the provider reported.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "outputTokens": {
      "description": "Response tokens the provider reported.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "inputTokens",
    "outputTokens"
  ],
  "title": "AiUsage",
  "type": "object"
}
