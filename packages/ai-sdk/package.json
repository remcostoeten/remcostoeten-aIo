{
  "name": "@remcostoeten/ai-sdk",
  "version": "0.2.0",
  "description": "Vercel AI SDK adapter and typed provider factories for the @remcostoeten/ai-core completion seam.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remcostoeten/remcostoeten-aIo.git",
    "directory": "packages/ai-sdk"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@remcostoeten/ai-core": "^0.2.0",
    "ai": "^7"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4",
    "@ai-sdk/google": "^4",
    "@ai-sdk/groq": "^4",
    "@ai-sdk/openai-compatible": "^3"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/anthropic": {
      "optional": true
    },
    "@ai-sdk/google": {
      "optional": true
    },
    "@ai-sdk/groq": {
      "optional": true
    },
    "@ai-sdk/openai-compatible": {
      "optional": true
    }
  }
}
